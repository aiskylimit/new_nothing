# Shared paper settings
TRAIN_NUM_PROCESSES="${TRAIN_NUM_PROCESSES:-2}"
EFFECTIVE_BATCH_SIZE="${EFFECTIVE_BATCH_SIZE:-32}"
LEARNING_RATE="${LEARNING_RATE:-5e-6}"
LORA_R="${LORA_R:-64}"
LORA_ALPHA="${LORA_ALPHA:-128}"
SFT_SAVE_STEPS="${SFT_SAVE_STEPS:-100}"
GRPO_SAVE_STEPS="${GRPO_SAVE_STEPS:-25}"
OPSD_SAVE_STEPS="${OPSD_SAVE_STEPS:-25}"
SEED="${SEED:-42}"

# Requested two-GPU batch layout
PER_DEVICE_BATCH_4B="${PER_DEVICE_BATCH_4B:-8}"
GRADIENT_ACCUMULATION_4B="${GRADIENT_ACCUMULATION_4B:-2}"
PER_DEVICE_BATCH_8B="${PER_DEVICE_BATCH_8B:-4}"
GRADIENT_ACCUMULATION_8B="${GRADIENT_ACCUMULATION_8B:-4}"
PER_DEVICE_BATCH_OLMO7B="${PER_DEVICE_BATCH_OLMO7B:-4}"
GRADIENT_ACCUMULATION_OLMO7B="${GRADIENT_ACCUMULATION_OLMO7B:-4}"

# Requested training decoding override
TRAIN_TEMPERATURE="${TRAIN_TEMPERATURE:-1.0}"
TRAIN_TOP_P="${TRAIN_TOP_P:-1.0}"
TRAIN_TOP_K="${TRAIN_TOP_K:-0}"

# SFT settings from Table 7
SFT_MAX_STEPS="${SFT_MAX_STEPS:-100}"
SFT_MAX_LENGTH="${SFT_MAX_LENGTH:-16000}"

# GRPO settings from Table 6
GRPO_MAX_STEPS="${GRPO_MAX_STEPS:-500}"
GRPO_NUM_GENERATIONS="${GRPO_NUM_GENERATIONS:-8}"
GRPO_MAX_COMPLETION_LENGTH="${GRPO_MAX_COMPLETION_LENGTH:-16000}"
GRPO_BETA="${GRPO_BETA:-0.0}"
# Keep the effective batch at 32 while bounding GRPO's long-sequence logits per GPU.
GRPO_PER_DEVICE_BATCH="${GRPO_PER_DEVICE_BATCH:-2}"
GRPO_GRADIENT_ACCUMULATION="${GRPO_GRADIENT_ACCUMULATION:-8}"

# OPSD settings from Table 6 and the released main-run configs
OPSD_MAX_STEPS="${OPSD_MAX_STEPS:-100}"
OPSD_MAX_LENGTH="${OPSD_MAX_LENGTH:-20000}"
OPSD_MAX_COMPLETION_LENGTH="${OPSD_MAX_COMPLETION_LENGTH:-1024}"
OPSD_BETA="${OPSD_BETA:-0.0}"
OPSD_CLIP_4B="${OPSD_CLIP_4B:-0.05}"
OPSD_CLIP_8B="${OPSD_CLIP_8B:-0.06}"
OPSD_CLIP_OLMO7B="${OPSD_CLIP_OLMO7B:-0.06}"

# Evaluation settings; top-p/top-k follow the requested override.
EVAL_MAX_NEW_TOKENS="${EVAL_MAX_NEW_TOKENS:-38912}"
EVAL_TEMPERATURE="${EVAL_TEMPERATURE:-1.0}"
EVAL_TOP_P="${EVAL_TOP_P:-1.0}"
EVAL_TOP_K="${EVAL_TOP_K:-0}"
EVAL_VAL_N="${EVAL_VAL_N:-12}"
EVAL_TENSOR_PARALLEL_SIZE="${EVAL_TENSOR_PARALLEL_SIZE:-2}"
OVERWRITE_EVAL="${OVERWRITE_EVAL:-1}"
